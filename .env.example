# Copy this file to .env and replace the example values.
# The SSH client uses your PRIVATE key; install its public key on each host.
GPU_TRACKER_SSH_USER=your_username
GPU_TRACKER_SSH_KEY=~/.ssh/id_ed25519
# cluster: label that groups machines in the dashboard (for example, lab-a).
# name: short machine label, unique within its cluster (for example, gpu01).
# host: actual SSH hostname, IP address, or SSH config alias to connect to.
GPU_TRACKER_TARGETS='[{"cluster":"lab-a","name":"gpu01","host":"gpu01.example.edu"},{"cluster":"lab-b","name":"gpu01","host":"gpu01.other.edu","port":22}]'
# Absolute directories on each host of the named cluster. Omit or use {} to disable scanning.
GPU_TRACKER_PROJECT_DIRS='{"lab-a":["/home/your_username/projects","/scratch/models"],"lab-b":["/work/checkpoints"]}'

# 0 means refresh at launch and only when Refresh data is clicked. Set 10 or higher for a timer.
GPU_TRACKER_REFRESH_SECONDS=0
